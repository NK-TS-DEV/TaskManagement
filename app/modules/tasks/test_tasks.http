@host = http://127.0.0.1:8000

###
POST {{host}}/auth/login
Content-Type: application/x-www-form-urlencoded

username=nikita@example.com&password=StrongPassword123!

> {%
    client.test("Login returns 200 and access_token", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(Boolean(response.body.access_token), "Missing access_token");
    });
    if (response.body && response.body.access_token) {
        client.global.set("auth_token", response.body.access_token);
    }
%}

###
GET {{host}}/tasks
Accept: application/json

###
POST {{host}}/tasks
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "title": "Implement FastAPI task endpoints",
  "description": "Add CRUD and status transitions",
  "priority": "High",
  "assignee_id": 1,
  "deadline": "2027-01-15T18:00:00Z",
  "status": "Backlog"
}

> {%
    client.test("Create task returns 201 and id", function() {
        client.assert(response.status === 201, "Expected 201 Created");
        client.assert(Boolean(response.body.id), "Missing task id");
    });
    if (response.body && response.body.id) {
        client.global.set("task_id", response.body.id);
    }
%}

###
GET {{host}}/tasks?status=Backlog
Authorization: Bearer {{auth_token}}
Accept: application/json

###
GET {{host}}/tasks/{{task_id}}
Authorization: Bearer {{auth_token}}
Accept: application/json

###
PATCH {{host}}/tasks/{{task_id}}
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "title": "Implement FastAPI task endpoints (updated)",
  "priority": "Critical"
}

###
PATCH {{host}}/tasks/{{task_id}}/status
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "status": "In Progress"
}

###
PATCH {{host}}/tasks/{{task_id}}/status
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "status": "Backlog"
}

###
DELETE {{host}}/tasks/{{task_id}}
Authorization: Bearer {{auth_token}}

###
PATCH {{host}}/tasks/{{task_id}}/status
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "status": "Review"
}

###
PATCH {{host}}/tasks/{{task_id}}/status
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "status": "Done"
}

###
PATCH {{host}}/tasks/{{task_id}}
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "title": "Should fail because task is Done"
}

###
DELETE {{host}}/tasks/{{task_id}}
Authorization: Bearer {{auth_token}}